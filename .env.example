# Server Port
PORT=3000

# Google Gemini API Key (Untuk AI Script & Generator Konten)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# YouTube Data API v3 OAuth2 Credentials
YOUTUBE_CLIENT_ID=YOUR_YOUTUBE_CLIENT_ID.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=YOUR_YOUTUBE_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN=YOUR_YOUTUBE_REFRESH_TOKEN
YOUTUBE_DEFAULT_PRIVACY=public

# TikTok Content Posting API Credentials
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
TIKTOK_ACCESS_TOKEN=YOUR_TIKTOK_ACCESS_TOKEN
TIKTOK_DEFAULT_PRIVACY=PUBLIC_TO_EVERYONE
